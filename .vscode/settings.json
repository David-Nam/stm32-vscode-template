{
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
  "C_Cpp.default.intelliSenseMode": "gcc-arm",
  "C_Cpp.default.cStandard": "c17",

  "cortex-debug.armToolchainPath": "${userHome}/.local/opt/arm-gnu-toolchain-15.3.rel1-darwin-arm64-arm-none-eabi/bin",
  "cortex-debug.gdbPath": "${userHome}/.local/opt/arm-gnu-toolchain-15.3.rel1-darwin-arm64-arm-none-eabi/bin/arm-none-eabi-gdb",

  // The Run/Debug play button on a C file makes the C/C++ extension append a
  // host-clang task to tasks.json and steal the default build task. There is
  // nothing to run on the host here, so turn the button off.
  "C_Cpp.debugShortcut": false,

  "cmake.generator": "Unix Makefiles",
  "cmake.buildDirectory": "${workspaceFolder}/build",
  "cmake.configureOnOpen": false,

  "files.associations": {
    "*.ld": "linkerscript",
    "*.ld.in": "linkerscript",
    "board.h.in": "c"
  },
  "files.exclude": { "build/": true }
}
